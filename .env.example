# ---------------------------------------------------------------- akun
# Admin pertama dibuat otomatis saat database masih kosong.
# Setelah login, buat akun anggota tim di menu "Kelola tim".
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ganti-dengan-password-kuat
ADMIN_NAME=Administrator

# true bila diakses lewat HTTPS (domain + Caddy). Biarkan false bila akses via http://IP.
COOKIE_SECURE=false

# ----------------------------------------------------------- model AI
# Isi minimal salah satu. Biaya dibayar per pemakaian di akun masing-masing.
ANTHROPIC_API_KEY=
# Opsional: daftar model Claude yang ditawarkan (default: opus 5.5, sonnet 5.5, haiku 5.5)
# ANTHROPIC_MODELS=claude-opus-5-5,claude-sonnet-5-5,claude-haiku-5-5

OPENAI_API_KEY=
# Opsional: daftar model GPT. Bila kosong, diambil otomatis dari akun OpenAI Anda.
# OPENAI_MODELS=

# Mode simulasi tanpa API (untuk mencoba alur). 1 = aktif.
LLM_MOCK=0

# ----------------------------------------------------------- rapat
# Waktu (ms) yang diberikan agar para lead berjalan ke ruang rapat sebelum diskusi dimulai.
MEETING_GATHER_MS=14000
# Jumlah putaran diskusi tiap lead (1 atau 2). 2 = lebih matang, token ~2x.
MEETING_ROUNDS=1

# ----------------------------------------------------------- server (docker compose)
# Domain untuk HTTPS otomatis (mis. office.contoh.com). Kosong = HTTP di port 80.
SITE_ADDRESS=
HTTP_PORT=80
HTTPS_PORT=443

# ----------------------------------------------------------- eksekusi
# Jumlah pekerjaan yang dikerjakan bersamaan setelah usulan disetujui (1–3).
EXECUTION_CONCURRENCY=2

# ----------------------------------------------------------- Google Drive (opsional)
# Isi untuk mengaktifkan tombol "Simpan ke Drive" di hasil kerja.
# 1. Buat service account di Google Cloud, aktifkan Google Drive API, unduh kunci JSON-nya.
# 2. Buat folder di Shared Drive, bagikan ke email service account sebagai Content manager.
# 3. Tempel isi JSON (boleh base64) dan ID folder di bawah.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_FOLDER_ID=
